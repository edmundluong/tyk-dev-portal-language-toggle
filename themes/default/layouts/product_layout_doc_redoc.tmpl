<!-- Layout used to render the API Product documentation -->
<!DOCTYPE html>
{{ $cookies := (req).Header.Get "Cookie" }}
{{/* Add a language by adding its code here (and to $rtlLangs if it reads
     right-to-left) -- nothing else in this block needs to change. This
     block is duplicated per layout file; keep all copies in sync. */}}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $rtlLangs := list "ar" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
<html lang="{{ $lang }}" {{ if has $lang $rtlLangs }}dir="rtl"{{ end }}>

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>{{.product.Name}}: {{.api.Name}} Documentation</title>

    <!-- Load style assets -->
    <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/stylesheets/fonts.css{{.previewId}}" rel="stylesheet">
    <link href="/assets/stylesheets/main.css{{.previewId}}" rel="stylesheet">
    {{ if has $lang $rtlLangs }}<link href="/assets/stylesheets/rtl.css" rel="stylesheet">{{ end }}

</head>

<body>

    <!-- Render top navigation menu -->
    {{ render "top_nav" . }}

    <!-- Render main page content -->
    {{ yield }}

    <!-- Render footer menu -->
    {{ render "footer" . }}

    <!-- Render custom documentation generator script -->
    <script src="https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js"> </script>
    
</body>

</html>
