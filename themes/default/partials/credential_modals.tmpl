{{ $cred := .cred }}
{{ $app := .app }}
{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{ $t := dict
  "rotate_title" (dict "en" "Rotate Credentials" "ar" "تدوير بيانات الاعتماد" "fr" "Faire pivoter les identifiants" "es" "Rotar credenciales")
  "rotate_body" (dict "en" "By rotating the credentials, you will receive a new set of credentials and the old ones won't apply anymore." "ar" "بتدوير بيانات الاعتماد، ستحصل على مجموعة جديدة ولن تعمل القديمة بعد الآن." "fr" "En faisant pivoter les identifiants, vous recevrez un nouveau jeu d'identifiants et les anciens ne seront plus valides." "es" "Al rotar las credenciales, recibirá un nuevo conjunto de credenciales y las anteriores dejarán de ser válidas.")
  "continue" (dict "en" "Do you wish to continue?" "ar" "هل تريد الاستمرار؟" "fr" "Souhaitez-vous continuer ?" "es" "¿Desea continuar?")
  "rotate_confirm" (dict "en" "Rotate credentials" "ar" "تدوير بيانات الاعتماد" "fr" "Faire pivoter les identifiants" "es" "Rotar credenciales")
  "revoke_title" (dict "en" "Revoke credentials?" "ar" "إلغاء بيانات الاعتماد؟" "fr" "Révoquer les identifiants ?" "es" "¿Revocar credenciales?")
  "revoke_body" (dict "en" "Revoking the credentials means it will no longer grant access to the given API product(s) and plan." "ar" "إلغاء بيانات الاعتماد يعني أنها لن تمنح الوصول بعد الآن إلى منتج (أو منتجات) API والخطة المحددة." "fr" "Révoquer les identifiants signifie qu'ils ne donneront plus accès au(x) produit(s) API et au plan concernés." "es" "Revocar las credenciales significa que dejarán de otorgar acceso al/a los producto(s) API y al plan indicados.")
  "revoke_confirm" (dict "en" "Revoke credentials" "ar" "إلغاء بيانات الاعتماد" "fr" "Révoquer les identifiants" "es" "Revocar credenciales")
  "cancel" (dict "en" "Cancel" "ar" "إلغاء" "fr" "Annuler" "es" "Cancelar")
}}

{{ if $cred.Credential }}
{{ render "confirmation_modal" (dict
  "id" (printf "rotate-%d" $cred.ID)
  "title" (index (index $t "rotate_title") $lang)
  "body" (raw (print "<p>" (index (index $t "rotate_body") $lang) "</p><p>" (index (index $t "continue") $lang) "</p>"))
  "confirmText" (index (index $t "rotate_confirm") $lang)
  "cancelText" (index (index $t "cancel") $lang)
  "confirmClass" "btn-primary"
  "formAction" "/portal/private/credentials"
  "hiddenFields" (dict "mode" "roll" "cred_id" $cred.ID "client_id" $app.ID)
) }}
{{ end }}

{{ render "confirmation_modal" (dict
  "id" (printf "revoke-%d" $cred.ID)
  "title" (index (index $t "revoke_title") $lang)
  "body" (raw (print "<p>" (index (index $t "revoke_body") $lang) "</p><p>" (index (index $t "continue") $lang) "</p>"))
  "confirmText" (index (index $t "revoke_confirm") $lang)
  "cancelText" (index (index $t "cancel") $lang)
  "confirmClass" "btn-danger"
  "formAction" "/portal/private/credentials"
  "hiddenFields" (dict "mode" "delete" "cred_id" $cred.ID "client_id" $app.ID)
) }}
