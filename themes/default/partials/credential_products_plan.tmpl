{{ $accessRequest := .accessRequest }}
{{ $showActions := .showActions }}
{{ $appID := .appID }}
{{ $credID := .credID }}
{{ $pendingPlan := .pendingPlan }}
{{ $hasPending := .hasPending }}
{{ $isAuthToken := .isAuthToken }}
{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{/* Only English has a compiled formatter (Plan.FormatQuota/FormatRateLimit).
     Every other language reconstructs from the raw fields via a printf
     template looked up here -- add a language by adding one entry, no new
     branch logic. */}}
{{ $planFormats := dict "ar" (dict
  "quota_unlimited" "غير محدود"
  "quota_n"         "%v طلب"
  "rate_unlimited"  "غير محدود"
  "rate_n"          "%v طلب / %v ثانية"
) "fr" (dict
  "quota_unlimited" "Illimité"
  "quota_n"         "%v appels"
  "rate_unlimited"  "Illimité"
  "rate_n"          "%v appels / %v s"
) "es" (dict
  "quota_unlimited" "Ilimitado"
  "quota_n"         "%v llamadas"
  "rate_unlimited"  "Ilimitado"
  "rate_n"          "%v llamadas / %v s"
) }}
{{ $t := dict
  "products_and_plan" (dict "en" "API products and plan access" "ar" "منتجات API والوصول إلى الخطة" "fr" "Produits API et accès au plan" "es" "Productos API y acceso al plan")
  "products_and_plan_desc" (dict "en" "API Products and plan this credential can access" "ar" "منتجات API والخطة التي يمكن لبيانات الاعتماد هذه الوصول إليها" "fr" "Produits API et plan auxquels ces identifiants peuvent accéder" "es" "Productos API y plan a los que puede acceder esta credencial")
  "browse_to_add" (dict "en" "Browse API products to add" "ar" "تصفح منتجات API لإضافتها" "fr" "Parcourir les produits API à ajouter" "es" "Explorar productos de API para añadir")
  "remove" (dict "en" "Remove" "ar" "إزالة" "fr" "Retirer" "es" "Quitar")
  "remove_title" (dict "en" "Remove %s from this credential" "ar" "إزالة %s من بيانات الاعتماد هذه" "fr" "Retirer %s de ces identifiants" "es" "Quitar %s de esta credencial")
  "remove_body" (dict "en" "You are about to remove this API Product from the selected credentials. Once removed:" "ar" "أنت على وشك إزالة منتج API هذا من بيانات الاعتماد المحددة. بعد الإزالة:" "fr" "Vous êtes sur le point de retirer ce produit API des identifiants sélectionnés. Une fois retiré :" "es" "Está a punto de quitar este producto API de las credenciales seleccionadas. Una vez eliminado:")
  "remove_li1" (dict "en" "The credentials will no longer have access to this API Product." "ar" "لن تتمتع بيانات الاعتماد بالوصول إلى منتج API هذا بعد الآن." "fr" "Les identifiants n'auront plus accès à ce produit API." "es" "Las credenciales dejarán de tener acceso a este producto API.")
  "remove_li2" (dict "en" "Any existing integrations using this API Product may stop working." "ar" "قد تتوقف أي عمليات تكامل حالية تستخدم منتج API هذا عن العمل." "fr" "Les intégrations existantes utilisant ce produit API risquent de cesser de fonctionner." "es" "Cualquier integración existente que utilice este producto API podría dejar de funcionar.")
  "remove_li3" (dict "en" "Associated rate limits, quotas, or usage tied to this API Product will no longer apply." "ar" "لن تُطبَّق بعد الآن حدود المعدل أو الحصص أو الاستخدام المرتبطة بمنتج API هذا." "fr" "Les limites de débit, quotas ou usages associés à ce produit API ne s'appliqueront plus." "es" "Los límites de tasa, cuotas o usos asociados a este producto API dejarán de aplicarse.")
  "proceed" (dict "en" "Do you want to proceed?" "ar" "هل تريد الاستمرار؟" "fr" "Voulez-vous continuer ?" "es" "¿Desea continuar?")
  "remove_confirm" (dict "en" "Remove API Product" "ar" "إزالة منتج API" "fr" "Retirer le produit API" "es" "Quitar producto API")
  "cancel" (dict "en" "Cancel" "ar" "إلغاء" "fr" "Annuler" "es" "Cancelar")
  "current" (dict "en" "Current" "ar" "الحالية" "fr" "Actuel" "es" "Actual")
  "quota" (dict "en" "Quota:" "ar" "الحصة:" "fr" "Quota :" "es" "Cuota:")
  "rate_limit" (dict "en" "Rate limit:" "ar" "حد المعدل:" "fr" "Limite de débit :" "es" "Límite de tasa:")
  "pending" (dict "en" "Pending" "ar" "معلَّق" "fr" "En attente" "es" "Pendiente")
  "change_plan" (dict "en" "Change Plan" "ar" "تغيير الخطة" "fr" "Changer de plan" "es" "Cambiar de plan")
}}

<div class="col-lg-12 requests-row-section p-3">
  <div class="d-flex justify-content-between p-3">
    <div>
      <h5 class="heading-small text-default m-0">{{ index (index $t "products_and_plan") $lang }}</h5>
      <p class="text-regular-14">{{ index (index $t "products_and_plan_desc") $lang }}</p>
    </div>
    {{ if $showActions }}
      <a class="btn btn-secondary-outline" href="/portal/catalogue-products">
        {{ index (index $t "browse_to_add") $lang }}
      </a>
    {{ end }}
  </div>

  <div class="p-3">
    {{ range $accessRequest.Products }}
      {{ $productPath := .Path }}
      <div class="card-section d-flex justify-content-between align-items-center mb-2">
        <a href="/portal/catalogue-products/{{ $productPath }}" class="text-regular-14 text-default-subdue mt-1">{{ .Name }}</a>
        {{ if and $showActions (gt (len $accessRequest.Products) 1) }}
          <button type="button"
                  class="btn-icon"
                  data-toggle="modal"
                  data-target="#remove-product-{{ .ID }}"
                  aria-label="{{ index (index $t "remove") $lang }} {{ .Name }}">
            <i class="tyk-icon tykon tykon-delete mt-1"></i>
          </button>
        {{ end }}
      </div>
    {{ end }}
  </div>

  {{ if and $showActions (gt (len $accessRequest.Products) 1) }}
    <!-- Confirmation modals for product removal -->
    {{ range $accessRequest.Products }}
      {{ render "confirmation_modal" (dict
        "id" (printf "remove-product-%d" .ID)
        "title" (printf (index (index $t "remove_title") $lang) .Name)
        "body" (raw (print "<p>" (index (index $t "remove_body") $lang) "</p><ul><li>" (index (index $t "remove_li1") $lang) "</li><li>" (index (index $t "remove_li2") $lang) "</li><li>" (index (index $t "remove_li3") $lang) "</li></ul><p>" (index (index $t "proceed") $lang) "</p>"))
        "confirmText" (index (index $t "remove_confirm") $lang)
        "confirmClass" "btn-secondary-outline"
        "cancelText" (index (index $t "cancel") $lang)
        "cancelClass" "btn-secondary-link"
        "formAction" (printf "/portal/private/apps/%d/access-requests/%d/products" $accessRequest.ClientID $accessRequest.ID)
        "formMethod" "post"
        "useForm" true
        "hiddenFields" (dict "product_id" .ID "mode" "delete")
      ) }}
    {{ end }}
  {{ end }}

  {{ if and $accessRequest.Plan $accessRequest.Plan.Name }}
  <div class="d-flex justify-content-between p-3">
    <div class="d-flex" style="gap: 1rem;">
      <!-- Current Plan Card -->
      <div class="basic-card p-4" style="min-width: 250px;">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h4 class="heading-medium text-default mb-0">{{ $accessRequest.Plan.Name }}</h4>
          <span class="pill text-regular-12">{{ index (index $t "current") $lang }}</span>
        </div>
        <h6 class="heading-xsmall mb-0">{{ index (index $t "quota") $lang }} {{ if eq $lang "en" }}{{ $accessRequest.Plan.FormatQuota }}{{ else }}{{ $pf := index $planFormats $lang }}{{ if $pf }}{{ if $accessRequest.Plan.UnlimitedQuota }}{{ index $pf "quota_unlimited" }}{{ else }}{{ printf (index $pf "quota_n") $accessRequest.Plan.QuotaMax }}{{ end }}{{ else }}{{ $accessRequest.Plan.FormatQuota }}{{ end }}{{ end }}</h6>
        <h6 class="heading-xsmall">{{ index (index $t "rate_limit") $lang }} {{ if eq $lang "en" }}{{ $accessRequest.Plan.FormatRateLimit }}{{ else }}{{ $pf := index $planFormats $lang }}{{ if $pf }}{{ if $accessRequest.Plan.UnlimitedRateLimit }}{{ index $pf "rate_unlimited" }}{{ else }}{{ printf (index $pf "rate_n") $accessRequest.Plan.Rate $accessRequest.Plan.Per }}{{ end }}{{ else }}{{ $accessRequest.Plan.FormatRateLimit }}{{ end }}{{ end }}</h6>
      </div>

      <!-- Pending Plan Card (if exists) -->
      {{ if $pendingPlan }}
      <div class="basic-card disabled p-4" style="min-width: 250px;">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h4 class="heading-medium text-default mb-0">{{ $pendingPlan.Name }}</h4>
          <span class="badge badge-yellow text-regular-12 p-1">
            {{ index (index $t "pending") $lang }}
          </span>
        </div>
        <h6 class="heading-xsmall mb-0">{{ index (index $t "quota") $lang }} {{ if eq $lang "en" }}{{ $pendingPlan.FormatQuota }}{{ else }}{{ $pf := index $planFormats $lang }}{{ if $pf }}{{ if $pendingPlan.UnlimitedQuota }}{{ index $pf "quota_unlimited" }}{{ else }}{{ printf (index $pf "quota_n") $pendingPlan.QuotaMax }}{{ end }}{{ else }}{{ $pendingPlan.FormatQuota }}{{ end }}{{ end }}</h6>
        <h6 class="heading-xsmall">{{ index (index $t "rate_limit") $lang }} {{ if eq $lang "en" }}{{ $pendingPlan.FormatRateLimit }}{{ else }}{{ $pf := index $planFormats $lang }}{{ if $pf }}{{ if $pendingPlan.UnlimitedRateLimit }}{{ index $pf "rate_unlimited" }}{{ else }}{{ printf (index $pf "rate_n") $pendingPlan.Rate $pendingPlan.Per }}{{ end }}{{ else }}{{ $pendingPlan.FormatRateLimit }}{{ end }}{{ end }}</h6>
      </div>
      {{ end }}
    </div>

    <!-- Change Plan Button (hidden if pending or authToken credential)
         TODO: authToken hidden temporarily until plan change flow is fully supported for auth tokens -->
    {{ if and $showActions (not $hasPending) (not $isAuthToken) }}
      <button type="button" class="btn btn-secondary-outline" data-toggle="modal" data-target="#change-plan-{{ $credID }}">
        {{ index (index $t "change_plan") $lang }}
      </button>
    {{ end }}
  </div>
  {{ end }}
</div>
