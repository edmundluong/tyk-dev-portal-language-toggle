{{ $cred := .cred }}
{{ $app := .app }}
{{ $isPending := .isPending }}
{{ $appCerts := .appCerts }}
{{ $allCerts := .allCerts }}
{{ $index := .index }}
{{ $pendingPlan := .pendingPlan }}
{{ $hasPending := .hasPending }}
{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{/* The `date` funcmap function has no locale awareness -- for any
     language with an entry in $monthNames, build the date manually from
     the numeric day/month/year pieces and a looked-up month name;
     languages with no entry (including English) fall back to `date`
     directly. */}}
{{ $monthNames := dict "ar" (dict "1" "يناير" "2" "فبراير" "3" "مارس" "4" "أبريل" "5" "مايو" "6" "يونيو" "7" "يوليو" "8" "أغسطس" "9" "سبتمبر" "10" "أكتوبر" "11" "نوفمبر" "12" "ديسمبر") "fr" (dict "1" "janvier" "2" "février" "3" "mars" "4" "avril" "5" "mai" "6" "juin" "7" "juillet" "8" "août" "9" "septembre" "10" "octobre" "11" "novembre" "12" "décembre") "es" (dict "1" "enero" "2" "febrero" "3" "marzo" "4" "abril" "5" "mayo" "6" "junio" "7" "julio" "8" "agosto" "9" "septiembre" "10" "octubre" "11" "noviembre" "12" "diciembre") }}
{{ $i18n := dict
  "edit_redirect_urls" (dict "en" "Edit redirect URLs" "ar" "تعديل روابط إعادة التوجيه" "fr" "Modifier les URL de redirection" "es" "Editar URL de redirección")
  "cancel" (dict "en" "Cancel" "ar" "إلغاء" "fr" "Annuler" "es" "Cancelar")
  "save_redirect_urls" (dict "en" "Save redirect URLs" "ar" "حفظ روابط إعادة التوجيه" "fr" "Enregistrer les URL de redirection" "es" "Guardar URL de redirección")
  "rotate_credentials" (dict "en" "Rotate credentials" "ar" "تدوير بيانات الاعتماد" "fr" "Faire pivoter les identifiants" "es" "Rotar credenciales")
  "revoke_credentials" (dict "en" "Revoke credentials" "ar" "إلغاء بيانات الاعتماد" "fr" "Révoquer les identifiants" "es" "Revocar credenciales")
  "date_requested" (dict "en" "Date requested:" "ar" "تاريخ الطلب:" "fr" "Date de la demande :" "es" "Fecha solicitada:")
  "expires" (dict "en" "Expires:" "ar" "تنتهي في:" "fr" "Expire le :" "es" "Caduca el:")
  "auth_method" (dict "en" "Auth Method:" "ar" "طريقة المصادقة:" "fr" "Méthode d'authentification :" "es" "Método de autenticación:")
  "redirect_urls" (dict "en" "Redirect URLs:" "ar" "روابط إعادة التوجيه:" "fr" "URL de redirection :" "es" "URL de redirección:")
  "will_be_set" (dict "en" "Will be set when approved" "ar" "سيتم تحديدها عند الموافقة" "fr" "Sera défini une fois approuvé" "es" "Se definirá cuando se apruebe")
  "no_redirect_urls" (dict "en" "No redirect URLs set" "ar" "لم يتم تحديد روابط إعادة توجيه" "fr" "Aucune URL de redirection définie" "es" "No se han definido URL de redirección")
  "separate_urls" (dict "en" "Separate URLs with commas" "ar" "اسم فصل الروابط بفواصل" "fr" "Séparez les URL par des virgules" "es" "Separe las URL con comas")
  "how_to_access" (dict "en" "How to access the API Product(s)" "ar" "كيفية الوصول إلى منتج (أو منتجات) API" "fr" "Comment accéder au(x) produit(s) API" "es" "Cómo acceder al/a los producto(s) API")
  "how_to_1" (dict "en" "Copy paste the client secret and ID in a POST request to the identity provider." "ar" "نسخ ولصق سر العميل والمعرّف في طلب POST إلى مزوّد الهوية." "fr" "Copiez-collez le secret client et l'ID dans une requête POST vers le fournisseur d'identité." "es" "Copie y pegue el secreto de cliente y el ID en una solicitud POST al proveedor de identidad.")
  "how_to_2" (dict "en" "Receive an access token issued by the identity provider." "ar" "استلام رمز وصول يصدره مزوّد الهوية." "fr" "Recevez un jeton d'accès émis par le fournisseur d'identité." "es" "Reciba un token de acceso emitido por el proveedor de identidad.")
  "how_to_3" (dict "en" "Use the access token to gain access to the API product." "ar" "استخدام رمز الوصول للوصول إلى منتج API." "fr" "Utilisez le jeton d'accès pour accéder au produit API." "es" "Utilice el token de acceso para acceder al producto API.")
  "learn_more" (dict "en" "Learn more" "ar" "تعرّف على المزيد" "fr" "En savoir plus" "es" "Más información")
  "credential_label" (dict "en" "Credential %d" "ar" "بيانات الاعتماد %d" "fr" "Identifiants %d" "es" "Credencial %d")
  "access_request_label" (dict "en" "Access Request %d" "ar" "طلب الوصول %d" "fr" "Demande d'accès %d" "es" "Solicitud de acceso %d")
}}
{{/* TypeOfCredential is a compiled Go function, not template text -- see the
     same note in catalogue_card.tmpl. Keep this list in sync. */}}
{{ $enumT := dict
  "oAuth2.0" (dict "ar" "OAuth 2.0" "fr" "OAuth 2.0" "es" "OAuth 2.0")
  "authToken" (dict "ar" "رمز المصادقة" "fr" "Jeton d'authentification" "es" "Token de autenticación")
  "Basic Auth" (dict "ar" "مصادقة أساسية" "fr" "Authentification de base" "es" "Autenticación básica")
  "oauth" (dict "ar" "OAuth 2.0" "fr" "OAuth 2.0" "es" "OAuth 2.0")
}}

{{ $credID := "" }}
{{ $alias := "" }}
{{ $isCustom := false }}
{{ $accessRequest := "" }}
{{ $dateValue := "" }}

{{ if $isPending }}
  {{ $credID = printf "%d" $cred.ID }}
  {{ if ne $index nil }}
    {{ $alias = printf (index (index $i18n "access_request_label") $lang) (add $index 1) }}
  {{ else }}
    {{ $alias = printf (index (index $i18n "access_request_label") $lang) $cred.ID }}
  {{ end }}
  {{ $accessRequest = $cred }}
  {{ $md := index $monthNames $lang }}
  {{ if $md }}
    {{ $dateValue = printf "%s %s %s" ($cred.CreatedAt | date "2") (index $md ($cred.CreatedAt | date "1")) ($cred.CreatedAt | date "2006") }}
  {{ else }}
    {{ $dateValue = ($cred.CreatedAt | date "2 Jan, 2006") }}
  {{ end }}
{{ else }}
  {{ $credID = $cred.ID }}
  {{ if $cred.Alias }}
    {{ $alias = $cred.Alias }}
  {{ else }}
    {{ if ne $index nil }}
      {{ $alias = printf (index (index $i18n "credential_label") $lang) (add $index 1) }}
    {{ else }}
      {{ $alias = printf (index (index $i18n "credential_label") $lang) $cred.ID }}
    {{ end }}
  {{ end }}
  {{ if eq $cred.CredentialType "CREDENTIAL_TYPE_CUSTOM" }}
    {{ $isCustom = true }}
  {{ end }}
  {{ $accessRequest = $cred.AccessRequest }}
{{ end }}

<div class="card p-0 mb-4">
  <div class="card-header d-flex flex-row justify-content-between align-items-center px-3 py-4"
       data-toggle="collapse"
       data-target="#credential-{{ $credID }}"
       aria-expanded="false"
       aria-controls="credential-{{ $credID }}"
       style="cursor: pointer;">
    <h3 class="heading-medium text-default m-0">{{ $alias }}</h3>
    <i class="tyk-icon tykon tykon-arrowdown credential-chevron"></i>
  </div>

  <div id="credential-{{ $credID }}" class="collapse">
    {{ if and (not $isPending) (not $isCustom) }}
      <div class="d-flex flex-row justify-content-end cta-btns-wrapper p-3 mr-3 flex-wrap">
        {{ if eq (TypeOfCredential $cred) "oAuth2.0" }}
          <button type="button"
                  class="btn btn-secondary btn-sm mr-3 enable-credential-editing-{{ $cred.ID }}"
                  onclick="enableCredentialEdit({{ $cred.ID }})">
            <i class="tyk-icon tykon tykon-edit mr-2"></i>{{ index (index $i18n "edit_redirect_urls") $lang }}
          </button>
          <button type="button"
                  class="btn btn-secondary-outline btn-sm mr-3 disable-credential-editing-{{ $cred.ID }} d-none"
                  onclick="cancelCredentialEdit({{ $cred.ID }})">
            {{ index (index $i18n "cancel") $lang }}
          </button>
          <button type="button"
                  class="btn btn-secondary btn-sm disable-credential-editing-{{ $cred.ID }} d-none"
                  onclick="saveCredentialEdit({{ $cred.ID }})">
            {{ index (index $i18n "save_redirect_urls") $lang }}
          </button>
        {{ end }}
        {{ if $cred.Credential }}
          <button type="button"
                  class="btn btn-secondary btn-sm mr-3 enable-credential-editing-{{ $cred.ID }}"
                  data-toggle="modal"
                  data-target="#rotate-{{ $cred.ID }}">
            <i class="tyk-icon tykon tykon-reload mr-2"></i>{{ index (index $i18n "rotate_credentials") $lang }}
          </button>
        {{ end }}
        <button type="button"
                class="btn btn-secondary btn-sm enable-credential-editing-{{ $cred.ID }}"
                data-toggle="modal"
                data-target="#revoke-{{ $cred.ID }}">
          <i class="tyk-icon tykon tykon-delete mr-2"></i>{{ index (index $i18n "revoke_credentials") $lang }}
        </button>
      </div>
    {{ end }}

    <div class="card-body d-flex flex-row justify-content-between flex-wrap">
      <div class="row">
        {{ if $isCustom }}
          {{ render "credential_info_row" (dict
            "label" "Key"
            "description" "A unique ID used to identify the application."
            "value" $cred.CredentialKey
            "showCopy" true
            "inputType" "password"
            "isPending" $isPending
            "pendingMessage" "Your key will appear here when approved"
            "showBorder" false
          ) }}
        {{ else }}
          {{ $tokenLabel := "Client ID" }}
          {{ $tokenValue := "" }}
          {{ if not $isPending }}
            {{ if $cred.Credential }}
              {{ $tokenLabel = "Token" }}
              {{ if $cred.CustomKeyID }}
                {{ $tokenValue = $cred.CustomKeyID }}
              {{ else }}
                {{ $tokenValue = $cred.Credential }}
              {{ end }}
            {{ else }}
              {{ $tokenValue = $cred.OAuthClientID }}
            {{ end }}
          {{ end }}

          {{ render "credential_info_row" (dict
            "label" $tokenLabel
            "description" "A unique ID used to identify the application."
            "value" $tokenValue
            "showCopy" true
            "inputType" "password"
            "isPending" $isPending
            "pendingMessage" (printf "Your %s will appear here when approved" (lower $tokenLabel))
            "showBorder" false
          ) }}
        {{ end }}

        {{ if $isCustom }}
          {{ render "credential_info_row" (dict
            "label" "Secret"
            "description" "This is the unique password for the app and auth server, do not share this information."
            "value" $cred.CredentialSecret
            "showCopy" true
            "inputType" "password"
            "isPending" $isPending
            "pendingMessage" "Your secret will appear here when approved"
          ) }}
        {{ else }}
          {{ $secretLabel := "Secret" }}
          {{ $secretValue := "" }}
          {{ if not $isPending }}
            {{ if $cred.Credential }}
              {{ $secretLabel = "Token Hash" }}
              {{ $secretValue = $cred.CredentialHash }}
            {{ else }}
              {{ $secretValue = $cred.OAuthClientSecret }}
            {{ end }}
          {{ end }}

          {{ render "credential_info_row" (dict
            "label" $secretLabel
            "description" "This is the unique password for the app and auth server, do not share this information."
            "value" $secretValue
            "showCopy" true
            "inputType" "password"
            "isPending" $isPending
            "pendingMessage" (printf "Your %s will appear here when approved" (lower $secretLabel))
          ) }}
        {{ end }}

        <div class="col-lg-12 requests-row-section">
          <div class="d-flex flex-row justify-content-between align-items-center flex-wrap p-3 requests-row-section__info">
            <div class="d-flex flex-column pr-3">
              <h6 class="heading-small text-default mr-4 mb-1">
                {{ if $isPending }}{{ index (index $i18n "date_requested") $lang }}{{ else }}{{ index (index $i18n "expires") $lang }}{{ end }}
              </h6>
            </div>
            <div class="text-regular-14 mb-1">
              {{ if $isPending }}
                {{ $dateValue }}
              {{ else }}
                {{ $cred.ExpiresAsString }}
              {{ end }}
            </div>
          </div>

          {{ if not $isCustom }}
            <div class="d-flex flex-row justify-content-between align-items-center flex-wrap p-3 requests-row-section__info">
              <div class="d-flex flex-column pr-3">
                <h6 class="heading-small text-default mr-4 mb-1">{{ index (index $i18n "auth_method") $lang }}</h6>
              </div>
              <div class="text-regular-14 mb-1">
                {{ if $isPending }}
                  {{ $atArTr := index $enumT $accessRequest.AuthType }}
                  {{ $atArDisplay := "" }}{{ if $atArTr }}{{ $atArDisplay = index $atArTr $lang }}{{ end }}
                  <span class="pill">{{ if $atArDisplay }}{{ $atArDisplay }}{{ else }}{{ $accessRequest.AuthType }}{{ end }}</span>
                {{ else }}
                  {{ $toc := TypeOfCredential $cred }}
                  {{ $tocArTr := index $enumT $toc }}
                  {{ $tocArDisplay := "" }}{{ if $tocArTr }}{{ $tocArDisplay = index $tocArTr $lang }}{{ end }}
                  <span class="pill">{{ if $tocArDisplay }}{{ $tocArDisplay }}{{ else }}{{ $toc }}{{ end }}</span>
                {{ end }}
              </div>
            </div>
          {{ end }}

          {{ if not $isCustom }}
            {{ if or (and $isPending (eq $accessRequest.AuthType "oauth")) (and (not $isPending) (eq (TypeOfCredential $cred) "oAuth2.0")) }}
              <div class="d-flex flex-row justify-content-between align-items-center flex-wrap p-3 requests-row-section__info">
                <div class="d-flex flex-column pr-3">
                  <h6 class="heading-small text-default mr-4 mb-1">{{ index (index $i18n "redirect_urls") $lang }}</h6>
                </div>
                <div class="text-regular-14 mb-1">
                  {{ if $isPending }}
                    <span><i>{{ index (index $i18n "will_be_set") $lang }}</i></span>
                  {{ else }}
                    <div class="credential-redirect-url-static">
                      <span>
                        {{ if $cred.RedirectURI }}
                          {{ $cred.RedirectURI }}
                        {{ else }}
                          <i>{{ index (index $i18n "no_redirect_urls") $lang }}</i>
                        {{ end }}
                      </span>
                    </div>
                    <div class="credential-redirect-url-edit d-none">
                      <input type="text"
                             name="credential_redirect_url_{{ $cred.ID }}"
                             class="form-control"
                             value="{{ $cred.RedirectURI }}"
                             style="min-width: 300px;">
                      <small class="form-text text-muted">{{ index (index $i18n "separate_urls") $lang }}</small>
                    </div>
                  {{ end }}
                </div>
              </div>
            {{ end }}
          {{ end }}

          {{ if not $isCustom }}
            {{ if or (and $isPending (eq $accessRequest.AuthType "oauth")) (and (not $isPending) (eq (TypeOfCredential $cred) "oAuth2.0")) }}
            <div class="col-lg-12 mt-4 mb-4">
              <div class="d-flex flex-column p-3 app-how-to">
                <div class="d-flex align-items-center mb-4">
                  <span><img src="/assets/images/icons/how-to.svg" class="mr-2"></span>
                  <h4 class="heading-small text-default mb-0 ml-2">{{ index (index $i18n "how_to_access") $lang }}</h4>
                </div>
                <div>
                  <ol>
                    <li>{{ index (index $i18n "how_to_1") $lang }}</li>
                    <li>{{ index (index $i18n "how_to_2") $lang }}</li>
                    <li>{{ index (index $i18n "how_to_3") $lang }}</li>
                  </ol>
                </div>
                <div>
                  <a href="/docs" target="_blank">
                    {{ index (index $i18n "learn_more") $lang }}
                    <i class="tyk-icon tykon tykon-link" aria-hidden="true"></i>
                  </a>
                </div>
              </div>
            </div>
            {{ end }}
          {{ end }}
        </div>
      </div>
    </div>

    {{ if and $accessRequest (not $isCustom) }}
      {{ render "credential_products_plan" (dict
        "accessRequest" $accessRequest
        "showActions" (not $isPending)
        "appID" $app.ID
        "credID" $credID
        "pendingPlan" $pendingPlan
        "hasPending" $hasPending
        "isAuthToken" (and (not $isPending) (eq (TypeOfCredential $cred) "authToken"))
      ) }}
    {{ end }}

    {{ if and (not $isCustom) (not $isPending) $accessRequest (eq $accessRequest.AuthType "multiAuth") }}
      {{ render "mtls_certificate_section" (dict
        "accessRequest" $accessRequest
        "appCerts" $appCerts
        "allCerts" $allCerts
        "appID" $app.ID
        "isPending" $isPending
      ) }}
    {{ end }}

    {{ if not $isCustom }}
      {{ if or (and $isPending (eq $accessRequest.AuthType "oauth")) (and (not $isPending) (eq (TypeOfCredential $cred) "oAuth2.0")) }}
        {{ render "oauth_client_type_info" (dict "cred" $cred "isPending" $isPending) }}
      {{ end }}
    {{ end }}

    {{ if and (not $isCustom) (not $isPending) $accessRequest $accessRequest.AllowSubscriptions }}
      {{ render "webhooks_section" (dict "cred" $cred "app" $app "isPending" $isPending) }}
    {{ end }}
  </div>
</div>

{{ if not $isPending }}
  {{ render "credential_modals" (dict "cred" $cred "app" $app) }}
  {{ if not $isCustom }}
    {{ render "change_plan_modal" (dict "cred" $cred "app" $app "credID" $credID "availablePlans" .availablePlans) }}
  {{ end }}
{{ end }}
