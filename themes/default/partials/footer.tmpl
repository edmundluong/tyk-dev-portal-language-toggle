<!-- Main footer menu used across the app -->

{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{ $footerT := dict
  "powered_by" (dict "en" "Powered by © Tyk Technologies" "ar" "بدعم من © Tyk Technologies" "fr" "Propulsé par © Tyk Technologies" "es" "Desarrollado por © Tyk Technologies")
}}
<footer>
    <div class="d-flex justify-content-center py-5">
        <div class="col-12 pl-5">
            <div class="row">
                <div class="col-xl-6">
                    <img src="/assets/images/dev-portal-logo.svg">
                    <h4 class="mt-3">{{ index (index $footerT "powered_by") $lang }}</h4>
                </div>
                {{ if GetMenus.Footer }}
                    {{ range GetMenus.Footer.Children }}
                        {{ $length := len GetMenus.Footer.Children }}
                        <div class="{{ if eq $length 0 }}col-xl-6
                            {{ else if eq $length 1 }}col-xl-6
                            {{ else if eq $length 2 }}col-xl-3
                            {{ else if eq $length 3 }}col-xl-2
                            {{ else }}col-xl-1
                            {{ end }}">
                            <h6 class="mb-3 mb-lg-4 footer-menu">
                                <a class="bold-text footer-menu__link" href="{{.Path}}">{{.Tag}}</a>
                            </h6>
                            <ul class="list-unstyled">
                                {{ range .Children }}
                                    <li>
                                        <a href="{{.Path}}">{{.Tag}}</a>
                                    </li>
                                {{ end }}
                            </ul>
                        </div>
                    {{ end }}
                {{ end }}
            </div>
        </div>
    </div>
</footer>

<!-- Load 3rd party Javascript assets -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

<!-- Load Tyk Javascript assets -->
<script type="module" src="/assets/javascripts/main.js{{.previewId}}"></script>

<!-- Translated content pages (home, about-us, ...) have a real twin Page
     per language at /<code>/<path> (authored via the Admin App's Pages/
     Content Blocks UI, then added to the map below). Everything else
     just reloads the same URL -- template chrome switches via the
     "tdp_locale" cookie regardless of path, no twin needed. Keep this
     map in sync with themes/README.md's content model section. -->
<script>
  // Add a language by adding one entry here: "<code>": { "<en-path>": "<twin-path>", ... }.
  // No other logic below needs to change.
  var TYK_PAGE_MAP = {
    "ar": {
      "/": "/ar",
      "/about-us": "/ar/about-us"
    },
    "fr": {
      "/": "/fr",
      "/about-us": "/fr/about-us"
    },
    "es": {
      "/": "/es",
      "/about-us": "/es/about-us"
    }
  };
  function tykCanonicalPath(path) {
    for (var lang in TYK_PAGE_MAP) {
      var map = TYK_PAGE_MAP[lang];
      for (var en in map) {
        if (map[en] === path) return en;
      }
    }
    return path; // already an English/canonical path, or unmapped
  }
  function tykSwitchLang(target) {
    var canonical = tykCanonicalPath(window.location.pathname);
    var dest = canonical;
    if (TYK_PAGE_MAP[target] && TYK_PAGE_MAP[target][canonical]) {
      dest = TYK_PAGE_MAP[target][canonical];
    }
    document.cookie = "tdp_locale=" + target + ";path=/;max-age=31536000";
    // Expire any leftover cookie literally named "lang" from before the
    // rename above -- a browser that still has it set would otherwise
    // keep re-triggering the GetProducts bug on every request forever.
    document.cookie = "lang=;path=/;max-age=0";
    window.location.href = dest;
  }
</script>
