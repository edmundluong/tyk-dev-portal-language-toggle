{{ $cred := .cred }}
{{ $isPending := .isPending }}
{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{ $t := dict
  "client_type_details" (dict "en" "Client type details" "ar" "تفاصيل نوع العميل" "fr" "Détails du type de client" "es" "Detalles del tipo de cliente")
  "client_type_desc" (dict "en" "The Client Type defines how your app will authenticate when calling secured APIs" "ar" "يحدد نوع العميل كيفية مصادقة تطبيقك عند استدعاء واجهات API المحمية" "fr" "Le type de client définit comment votre application s'authentifiera lors de l'appel d'API sécurisées" "es" "El tipo de cliente define cómo se autenticará su aplicación al llamar a API seguras")
  "client_type_name" (dict "en" "Client type name:" "ar" "اسم نوع العميل:" "fr" "Nom du type de client :" "es" "Nombre del tipo de cliente:")
  "not_defined" (dict "en" "Not defined" "ar" "غير محدَّد" "fr" "Non défini" "es" "No definido")
  "client_type_description" (dict "en" "Client type description:" "ar" "وصف نوع العميل:" "fr" "Description du type de client :" "es" "Descripción del tipo de cliente:")
  "grant_types" (dict "en" "Grant types:" "ar" "أنواع المنح:" "fr" "Types d'autorisation :" "es" "Tipos de concesión:")
  "response_types" (dict "en" "Response types:" "ar" "أنواع الاستجابة:" "fr" "Types de réponse :" "es" "Tipos de respuesta:")
  "token_endpoint_auth" (dict "en" "Token endpoint auth method:" "ar" "طريقة مصادقة نقطة نهاية الرمز:" "fr" "Méthode d'authentification du point de terminaison de jeton :" "es" "Método de autenticación del punto de conexión del token:")
  "scope_permission" (dict "en" "Scope permission:" "ar" "إذن النطاق:" "fr" "Autorisation de portée :" "es" "Permiso de alcance:")
}}

{{ if not $isPending }}
<div class="col-lg-12 p-3 requests-row-section">
  <div class="d-flex flex-row justify-content-between align-items-start p-3"
       data-toggle="collapse"
       data-target="#type-details-{{ $cred.ID }}"
       aria-expanded="false"
       aria-controls="type-details-{{ $cred.ID }}"
       style="cursor: pointer;">
    <div>
      <h5 class="heading-small text-default m-0">{{ index (index $t "client_type_details") $lang }}</h5>
      <p class="text-regular-14 m-0">{{ index (index $t "client_type_desc") $lang }}</p>
    </div>
    <i class="tyk-icon tykon tykon-arrowdown credential-chevron"></i>
  </div>

  <div id="type-details-{{ $cred.ID }}" class="collapse">
    <div class="p-3">
      <div class="col-lg-12">
          <div class="d-flex flex-row justify-content-between align-items-start flex-wrap p-3 requests-row-section__info">
            <div class="d-flex flex-column pr-3">
              <h6 class="heading-small text-default mr-4 mb-1">{{ index (index $t "client_type_name") $lang }}</h6>
            </div>
            <div class="text-regular-14 mb-1">
              {{ if not (eq (GetClientName $cred.ID) "" )}}
                {{ GetClientName $cred.ID}}
              {{ else }}
                {{ index (index $t "not_defined") $lang }}
              {{ end }}
            </div>
          </div>

          <div class="d-flex flex-row justify-content-between align-items-start flex-wrap p-3 requests-row-section__info">
            <div class="d-flex flex-column pr-3">
              <h6 class="heading-small text-default mr-4 mb-1">{{ index (index $t "client_type_description") $lang }}</h6>
            </div>
            <div class="text-regular-14 mb-1">
              {{ if not (eq (GetClientDescription $cred.ID) "" )}}
                {{ GetClientDescription $cred.ID}}
              {{ else }}
                {{ index (index $t "not_defined") $lang }}
              {{ end }}
            </div>
          </div>

          <div class="d-flex flex-row justify-content-between align-items-start flex-wrap p-3 requests-row-section__info">
            <div class="d-flex flex-column pr-3">
              <h6 class="heading-small text-default mr-4 mb-1">{{ index (index $t "grant_types") $lang }}</h6>
            </div>
            <div class="text-regular-14 mb-1">
              {{ if not (eq $cred.GrantType "") }}
                {{ range SplitStrings $cred.GrantType "," }}
                  <div class="d-flex align-items-center">
                    <span class="client-type-tick mr-2"><img src="/assets/images/icons/tick.svg"></span>
                    <span>{{ . }}</span>
                  </div>
                {{ end }}
              {{ else }}
                {{ index (index $t "not_defined") $lang }}
              {{ end }}
            </div>
          </div>

          <div class="d-flex flex-row justify-content-between align-items-start flex-wrap p-3 requests-row-section__info">
            <div class="d-flex flex-column pr-3">
              <h6 class="heading-small text-default mr-4 mb-1">{{ index (index $t "response_types") $lang }}</h6>
            </div>
            <div class="text-regular-14 mb-1">
              {{ if not (eq $cred.ResponseType "") }}
                {{ range SplitStrings $cred.ResponseType "," }}
                  <div class="d-flex align-items-center">
                    <span class="client-type-tick mr-2"><img src="/assets/images/icons/tick.svg"></span>
                    <span>{{ . }}</span>
                  </div>
                {{ end }}
              {{ else }}
                {{ index (index $t "not_defined") $lang }}
              {{ end }}
            </div>
          </div>

          <div class="d-flex flex-row justify-content-between align-items-startflex-wrap p-3 requests-row-section__info">
            <div class="d-flex flex-column pr-3">
              <h6 class="heading-small text-default mr-4 mb-1">{{ index (index $t "token_endpoint_auth") $lang }}</h6>
            </div>
            <div class="text-regular-14 mb-1">
              {{ if not (eq $cred.TokenEndpoints "" )}}
                {{ $cred.TokenEndpoints }}
              {{ else }}
                {{ index (index $t "not_defined") $lang }}
              {{ end }}
            </div>
          </div>

          <div class="d-flex flex-row justify-content-between align-items-start flex-wrap p-3 requests-row-section__info">
            <div class="d-flex flex-column pr-3">
              <h6 class="heading-small text-default mr-4 mb-1">{{ index (index $t "scope_permission") $lang }}</h6>
            </div>
            <div class="text-regular-14 mb-1">
              {{ if not (eq $cred.Scope "") }}
                {{ range SplitStrings $cred.Scope " " }}
                  <div class="d-flex align-items-center">
                    <span class="client-type-tick mr-2"><img src="/assets/images/icons/tick.svg"></span>
                    <span>{{ . }}</span>
                  </div>
                {{ end }}
              {{ else }}
                {{ index (index $t "not_defined") $lang }}
              {{ end }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{{ end }}
