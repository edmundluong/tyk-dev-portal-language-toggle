{{$error := .error}}
{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{ $t := dict
  "heading" (dict "en" "Log in to your Tyk Developer Portal account" "ar" "تسجيل الدخول إلى حساب بوابة مطوري Tyk" "fr" "Connectez-vous à votre compte Tyk Developer Portal" "es" "Inicie sesión en su cuenta del portal del desarrollador de Tyk")
  "email" (dict "en" "Email address" "ar" "البريد الإلكتروني" "fr" "Adresse e-mail" "es" "Dirección de correo electrónico")
  "password" (dict "en" "Password" "ar" "كلمة المرور" "fr" "Mot de passe" "es" "Contraseña")
  "forgot" (dict "en" "Forgot Password?" "ar" "هل نسيت كلمة المرور؟" "fr" "Mot de passe oublié ?" "es" "¿Olvidó su contraseña?")
  "submit" (dict "en" "Log in" "ar" "تسجيل الدخول" "fr" "Se connecter" "es" "Iniciar sesión")
  "no_account" (dict "en" "Don’t have an account?" "ar" "ليس لديك حساب؟" "fr" "Vous n'avez pas de compte ?" "es" "¿No tiene una cuenta?")
  "sign_up" (dict "en" "Sign up" "ar" "إنشاء حساب" "fr" "S'inscrire" "es" "Registrarse")
}}
<div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 login-page-wrapper">
  <a href="/" class="logo d-flex">
    <img src="/assets/images/new-logo.svg" alt="Tyk Logo" />
  </a>
  <div class="login-form-wrapper">
    <label class="title-inter login-form-title mt-5">{{ index (index $t "heading") $lang }}</label>
    {{ if $error }}
    <div class="alert alert-danger" role="alert">
      <i class="tyk-icon tykon tykon-warning "></i>
      <div class="alert__content">{{ .error }}</div>
    </div>
    {{ end }}
    <form action="login" method="post" class="mb-5">
      <div class="form-group">
        <label class="form-label login-form-label mb-1">{{ index (index $t "email") $lang }}</label>
        <input type="email" name="login" class="form-control login-form-input" value="" required />
      </div>
      <div class="form-group mb-0">
        <label class="form-label login-form-label mb-1">{{ index (index $t "password") $lang }}</label>
        <input type="password" name="password" class="form-control login-form-input" value="" required autocomplete="off" />
      </div>
      <div class="form-group mt-2">
        <a href="/auth/password/new" class="brand-link login-form-label">{{ index (index $t "forgot") $lang }}</a>
      </div>
      <div class="form-group mt-4 text-center">
        <input type="submit" name="submit" class="btn portal-primary" value="{{ index (index $t "submit") $lang }}" />
      </div>
      <div class="form-group text-center">
        <span class="login-form-label login-form-info">{{ index (index $t "no_account") $lang }}</span>
        <a href="/auth/password/register" class="brand-link login-form-label">{{ index (index $t "sign_up") $lang }}</a>
      </div>
    </form>
  </div>
</div>
