{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{ $t := dict
  "heading" (dict "en" "Forgot Password?" "ar" "هل نسيت كلمة المرور؟" "fr" "Mot de passe oublié ?" "es" "¿Olvidó su contraseña?")
  "sent" (dict "en" "An email to reset password has been sent. Check your inbox." "ar" "تم إرسال بريد إلكتروني لإعادة تعيين كلمة المرور. تحقق من صندوق الوارد." "fr" "Un e-mail de réinitialisation du mot de passe a été envoyé. Vérifiez votre boîte de réception." "es" "Se ha enviado un correo para restablecer la contraseña. Revise su bandeja de entrada.")
  "email" (dict "en" "Email address" "ar" "البريد الإلكتروني" "fr" "Adresse e-mail" "es" "Dirección de correo electrónico")
  "email_ph" (dict "en" "Your Email *" "ar" "بريدك الإلكتروني *" "fr" "Votre e-mail *" "es" "Su correo electrónico *")
  "reset" (dict "en" "Reset" "ar" "إعادة التعيين" "fr" "Réinitialiser" "es" "Restablecer")
}}
<div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 login-page-wrapper" style="background: url('/assets/images/login.svg') center center no-repeat, linear-gradient(93.59deg, #36364C 19.75%, #505071 81.94%);">
  <div class="login-form-wrapper p-4">
    <h2 class="mb-5 text-center">{{ index (index $t "heading") $lang }}</h2>
    <form action="/auth/password/new" method="post" class="mb-5">
        {{ if .error }}
          <div class="alert alert-danger" role="alert">
            <i class="tyk-icon tykon tykon-warning "></i>
            <div class="alert__content">{{ .error }}</div>
          </div>
        {{ end }}
        {{ if .done }}
          <div class="alert alert-success" role="alert">
            <i class="tyk-icon tykon tykon-check "></i>
            <div class="alert__content">{{ index (index $t "sent") $lang }}</div>
          </div>
        {{ else }}
          <div class="form-group">
            <label class="form-label">{{ index (index $t "email") $lang }}</label>
            <input type="email" name="email" class="form-control" placeholder="{{ index (index $t "email_ph") $lang }}" value="" required />
            <input type="hidden" name="origin" value="form">
          </div>
          <div class="form-group text-center">
            <input type="submit" name="submit" class="btn btn-primary" value="{{ index (index $t "reset") $lang }}" />
          </div>
        {{end}}
    </form>
  </div>
</div>
