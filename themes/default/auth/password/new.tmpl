{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{ $t := dict
  "heading" (dict "en" "Forgot your password?" "ar" "هل نسيت كلمة المرور؟" "fr" "Mot de passe oublié ?" "es" "¿Olvidó su contraseña?")
  "email" (dict "en" "Email address" "ar" "البريد الإلكتروني" "fr" "Adresse e-mail" "es" "Dirección de correo electrónico")
  "reset_password" (dict "en" "Reset password" "ar" "إعادة تعيين كلمة المرور" "fr" "Réinitialiser le mot de passe" "es" "Restablecer contraseña")
  "return_login" (dict "en" "Return to Log in" "ar" "العودة إلى تسجيل الدخول" "fr" "Retour à la connexion" "es" "Volver al inicio de sesión")
}}
<div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 login-page-wrapper">
  <a href="/" class="logo d-flex">
    <img src="/assets/images/new-logo.svg" alt="Tyk Logo" />
  </a>
  <div class="login-form-wrapper">
    <label class="title-inter login-form-title mt-5">{{ index (index $t "heading") $lang }}</label>
      {{$flashes := .Flashes}}
      {{if $flashes}}
        <ul>
          {{range $flash := $flashes}}
            <li class="login-form-label login-form-info text-center">{{$flash.Message}}</li>
          {{end}}
        </ul>
      {{end}}
      {{$url := AuthURL "password/recover"}}
    <form action={{$url}} method="post" class="mb-5">
      <div class="form-group">
        <label class="form-label login-form-label mb-1">{{ index (index $t "email") $lang }}</label>
        <input type="email" name="email" class="form-control login-form-input" value="" required />
        <input type="hidden" name="origin" value="form">
      </div>
      <div class="form-group mt-5 text-center">
        <input type="submit" name="submit" class="btn portal-primary" value="{{ index (index $t "reset_password") $lang }}" />
      </div>
      <div class="form-group text-center">
        <a href="{{LoginURL}}" class="brand-link login-form-label">{{ index (index $t "return_login") $lang }}</a>
      </div>
    </form>
  </div>
</div>
