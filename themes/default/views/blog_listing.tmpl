{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{ $i18n := dict
  "no_posts" (dict "en" "No blog posts to be shown." "ar" "لا توجد منشورات مدونة لعرضها." "fr" "Aucun article de blog à afficher." "es" "No hay artículos de blog que mostrar.")
  "keep_reading" (dict "en" "Keep reading" "ar" "اقرأ المزيد" "fr" "Continuer la lecture" "es" "Seguir leyendo")
}}
{{/* The `date` funcmap function formats via Go's reference layout, which
     has no locale awareness -- "Jan" always renders the English month
     abbreviation regardless of $lang. Build the Arabic date manually from
     the numeric day/month/year pieces instead. */}}
{{ $monthNames := dict "ar" (dict "1" "يناير" "2" "فبراير" "3" "مارس" "4" "أبريل" "5" "مايو" "6" "يونيو" "7" "يوليو" "8" "أغسطس" "9" "سبتمبر" "10" "أكتوبر" "11" "نوفمبر" "12" "ديسمبر") "fr" (dict "1" "janvier" "2" "février" "3" "mars" "4" "avril" "5" "mai" "6" "juin" "7" "juillet" "8" "août" "9" "septembre" "10" "octobre" "11" "novembre" "12" "décembre") "es" (dict "1" "enero" "2" "febrero" "3" "marzo" "4" "abril" "5" "mayo" "6" "junio" "7" "julio" "8" "agosto" "9" "septiembre" "10" "octubre" "11" "noviembre" "12" "diciembre") }}
{{/* Header title/lede for the blog listing page, set as static, theme-owned
     copy per language -- the same dict "en"/"ar"/"fr"/"es" pattern as
     every other translated string in this theme. */}}
{{ $blogHeaderT := dict
  "title" (dict "en" "Blog, insight and latest news" "ar" "المدونة، الأفكار وآخر الأخبار" "fr" "Blog, analyses et dernières actualités" "es" "Blog, análisis y últimas noticias")
  "lede" (dict "en" "Technical guides, feature mechanics and updates for the developer community." "ar" "أدلة تقنية وآليات المزايا وتحديثات لمجتمع المطورين." "fr" "Guides techniques, mécaniques des fonctionnalités et actualités pour la communauté des développeurs." "es" "Guías técnicas, mecánicas de funciones y novedades para la comunidad de desarrolladores.")
}}
{{ $blogTitle := index (index $blogHeaderT "title") $lang }}
{{ $blogLede := index (index $blogHeaderT "lede") $lang }}
<div class="blog-page-wrapper">
  <header class="dark-to-light-bg">
    <div class="container">
      <div class="row">
        <div class="col-sm-6">
          <div class="text-container">
            <h1>{{ $blogTitle }}</h1>
            <p>{{ $blogLede }}</p>
          </div>
        </div>
        <div class="col-sm-6 image-container" style="background: url('/assets/images/blog.svg') no-repeat left center;">
          {{.blocks.BackgroundImage.Image.URL}}</div>
      </div>
    </div>
  </header>
  <div class="container">
    <div class="row">
    {{ $length := len .posts }}
    {{ if eq $length 0 }}
      <div class="col-md-12 text-center mt-4">
        <div class="alert alert-info" role="alert">
          <i class="tyk-icon tykon tykon-warning "></i>
          <div class="alert__content">{{ index (index $i18n "no_posts") $lang }}</div>
        </div>
      </div>
    {{ else }}
      <div class="col-md-12">
        <div class="row justify-content-center mt-4">
          {{/* Posts have no locale field either -- same path-prefix filter
               as catalogue.tmpl's Catalogue Products, since twin posts
               across languages would otherwise show together regardless of
               language. See seed-arabic-pages.sql / seed-french-pages.sql.
               Add a `hasPrefix` line here for each language with its own
               post twin. */}}
          {{ $shown := 0 }}
          {{ range $i, $val := .posts }}
            {{ $postLang := "en" }}
            {{ if hasPrefix "ar-" $val.Path }}{{ $postLang = "ar" }}{{ end }}
            {{ if hasPrefix "fr-" $val.Path }}{{ $postLang = "fr" }}{{ end }}
            {{ if hasPrefix "es-" $val.Path }}{{ $postLang = "es" }}{{ end }}
            {{ if eq $postLang $lang }}
              {{ $shown = add $shown 1 }}
              <div class="col-lg-4 card-container">
                <div class="card blog h-100 {{ if eq $val.HeaderImage.URL "" }}dark-background{{ end }}">
                  {{ if $val.HeaderImage.URL }}
                    <img class="card-image-border-card-view" src='{{$val.HeaderImage.URL "preview"}}'/>
                  {{ end }}
                  <div class="card-body d-flex flex-column justify-content-start p-4 mt-5 mr-5">
                    <p class="body-large-default mb-0"> {{ $md := index $monthNames $lang }}{{ if $md }}{{ .CreatedAt | date "2" }} {{ index $md (.CreatedAt | date "1") }} {{ .CreatedAt | date "2006" }}{{ else }}{{.CreatedAt | date "2 Jan, 2006" }}{{ end }}</p>
                    <h2 class="card-title heading-xlarge d-flex flex-column justify-content-end mt-2">{{ $val.Title }}</h2>
                    <p class="text-uppercase">
                      {{ $val.Lede }}</p>
                  </div>
                  <p class="card-text blog__category align-self-center">
                    <span>
                      {{ range $idx, $category := $val.Categories }}
                        {{ $category.Name }}{{ if and (gt (len $val.Categories) 1) (lt $idx (add (len $val.Categories) -1)) }},{{end}}
                      {{ end }}
                    </span>
                  </p>
                  <div class="card-cta align-self-center">
                    <a href="{{$val.URL}}" class="btn btn-secondary">{{ index (index $i18n "keep_reading") $lang }}</a>
                  </div>
                </div>
              </div>
            {{ end }}
          {{ end }}
          {{ if eq $shown 0 }}
            <div class="col-md-12 text-center mt-4">
              <div class="alert alert-info" role="alert">
                <i class="tyk-icon tykon tykon-warning "></i>
                <div class="alert__content">{{ index (index $i18n "no_posts") $lang }}</div>
              </div>
            </div>
          {{ end }}
        </div>
      </div>
    {{ end }}
    </div>
  </div>
</div>
