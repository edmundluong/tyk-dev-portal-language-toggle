<!-- Template used for listing the Products -->
{{ $portalDisabled := IsPortalDisabled req }}
{{ $portalPrivate  := IsPortalPrivate req }}
{{ $cookies := (req).Header.Get "Cookie" }}
{{ $supportedLangs := list "en" "ar" "fr" "es" }}
{{ $lang := "en" }}
{{ range $supportedLangs }}{{ if regexMatch (printf "tdp_locale=%s" .) $cookies }}{{ $lang = . }}{{ end }}{{ end }}
{{ $t := dict
  "disabled" (dict "en" "disabled" "ar" "معطّلة" "fr" "désactivé" "es" "desactivado")
  "private" (dict "en" "private" "ar" "خاصة" "fr" "privé" "es" "privado")
  "portal_is" (dict "en" "This Portal is" "ar" "هذه البوابة" "fr" "Ce portail est" "es" "Este portal está")
  "browse_apis" (dict "en" "Browse and discover APIs available in your organization" "ar" "تصفح واكتشف واجهات برمجة التطبيقات المتاحة في مؤسستك" "fr" "Parcourez et découvrez les API disponibles dans votre organisation" "es" "Explore y descubra las API disponibles en su organización")
  "search_ph" (dict "en" "Search" "ar" "بحث" "fr" "Rechercher" "es" "Buscar")
  "search" (dict "en" "Search" "ar" "بحث" "fr" "Rechercher" "es" "Buscar")
  "no_apis" (dict "en" "No APIs found." "ar" "لم يتم العثور على واجهات برمجة تطبيقات." "fr" "Aucune API trouvée." "es" "No se encontraron API.")
  "view_as_list" (dict "en" "View as list" "ar" "عرض كقائمة" "fr" "Afficher en liste" "es" "Ver como lista")
  "view_as_grid" (dict "en" "View as grid" "ar" "عرض كشبكة" "fr" "Afficher en grille" "es" "Ver como cuadrícula")
}}
{{/* GetCatalogueList synthesizes a "show everything" pseudo-entry named
     "All Catalogues" in Go alongside the real catalogue names. The default
     catalogues `make bootstrap` creates ("Public Catalogue", "Private
     Catalogue") are admin-authored text, so their translated labels are
     provided here by exact name match -- these three names are known,
     fixed constants, not free text this template generates. Guarded so a
     language with no entry falls through to the real name automatically. */}}
{{ $catalogueNameOverrides := dict
  "All Catalogues" (dict "ar" "جميع الكتالوجات" "fr" "Tous les catalogues" "es" "Todos los catálogos")
  "Public Catalogue" (dict "ar" "الكتالوج العام" "fr" "Catalogue public" "es" "Catálogo público")
  "Private Catalogue" (dict "ar" "الكتالوج الخاص" "fr" "Catalogue privé" "es" "Catálogo privado")
}}
{{/* .page is the Page record backing this fixed URL (/portal/catalogue-products).
     This route doesn't have a separate translated Page per language the way
     Home/About Us do, so the title is translated directly here instead.
     Keep this in sync with the real .page.Title if it's ever changed in
     the Admin App. */}}
{{ $pageTitle := .page.Title }}
{{ $pageTitleOverrides := dict "ar" "كتالوجات المنتجات" "fr" "Catalogues de produits" "es" "Catálogos de productos" }}
{{ $ptOverride := index $pageTitleOverrides $lang }}
{{ if $ptOverride }}{{ $pageTitle = $ptOverride }}{{ end }}
{{ if or $portalDisabled $portalPrivate }}
<div class="container">
  <div class="row">
    <div class="col-md-12 mb-5">
      <h2>{{ index (index $t "portal_is") $lang }} {{ if $portalDisabled }}{{ index (index $t "disabled") $lang }}{{ else }}{{ index (index $t "private") $lang }}{{ end }}</h2>
    </div>
  </div>
</div>
{{ else }}
<div class="catalogue-page-wrapper pb-5">
  <div class="container">
    {{/* Page Header with Title */}}
    <div class="catalogue-header">
      <div class="catalogue-header__title">
        <h1 class="heading-xlarge">{{ $pageTitle }}</h1>
        <p class="body-large-default text-default-subdue">{{ index (index $t "browse_apis") $lang }}</p>
      </div>
    </div>

    {{/* Search, Filter Controls and View Toggle */}}
    <form class="catalogue-controls">
      <div class="input-group search-container">
        <input type="text" placeholder="{{ index (index $t "search_ph") $lang }}" class="form-control search-input" id="search" name="search">
      </div>
      <div class="filter-container">
        <select class="form-select" id="catalogue" name="catalogue">
        {{ range $key, $value := GetCatalogueList req }}
          {{ $catNameOverridesForValue := index $catalogueNameOverrides $value.Name }}
          {{ $catNameDisplay := "" }}{{ if $catNameOverridesForValue }}{{ $catNameDisplay = index $catNameOverridesForValue $lang }}{{ end }}
          <option value="{{ $key }}" {{ if eq $value.Selected true }} selected {{ end }}>{{ if $catNameDisplay }}{{ $catNameDisplay }}{{ else }}{{ $value.Name }}{{ end }}</option>
        {{ end }}
        </select>
      </div>
      <button type="submit" class="btn btn-primary-outline">{{ index (index $t "search") $lang }}</button>
      <div class="catalogue-controls__view-toggle">
        <button id="view-as-list" type="button" aria-label="{{ index (index $t "view_as_list") $lang }}">
          <svg width="20" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 0.909091C21 1.41117 20.593 1.81818 20.0909 1.81818H0.90909C0.407014 1.81818 0 1.41117 0 0.909091V0.909091C0 0.407014 0.407014 0 0.909091 0H20.0909C20.593 0 21 0.407014 21 0.909091V0.909091ZM21 5.45455C21 4.95247 20.593 4.54545 20.0909 4.54545H0.90909C0.407014 4.54545 0 4.95247 0 5.45455V5.45455C0 5.95662 0.407014 6.36364 0.909091 6.36364H20.0909C20.593 6.36364 21 5.95662 21 5.45455V5.45455ZM21 10C21 9.49792 20.593 9.09091 20.0909 9.09091H0.90909C0.407014 9.09091 0 9.49792 0 10V10C0 10.5021 0.407014 10.9091 0.909091 10.9091H20.0909C20.593 10.9091 21 10.5021 21 10V10ZM21 14.5455C21 14.0434 20.593 13.6364 20.0909 13.6364H0.90909C0.407014 13.6364 0 14.0434 0 14.5455V14.5455C0 15.0475 0.407014 15.4545 0.909091 15.4545H20.0909C20.593 15.4545 21 15.0475 21 14.5455V14.5455ZM21 19.0909C21 18.5888 20.593 18.1818 20.0909 18.1818H0.90909C0.407014 18.1818 0 18.5888 0 19.0909V19.0909C0 19.593 0.407014 20 0.909091 20H20.0909C20.593 20 21 19.593 21 19.0909V19.0909Z"/>
          </svg>
        </button>
        <button id="view-as-cards" type="button" class="active" aria-label="{{ index (index $t "view_as_grid") $lang }}">
          <svg width="20" height="20" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5.25 4.25C5.25 4.80228 4.80228 5.25 4.25 5.25H1C0.447715 5.25 0 4.80228 0 4.25V1C0 0.447715 0.447715 0 1 0H4.25C4.80228 0 5.25 0.447715 5.25 1V4.25ZM13.125 1C13.125 0.447715 12.6773 0 12.125 0H8.875C8.32272 0 7.875 0.447715 7.875 1V4.25C7.875 4.80228 8.32272 5.25 8.875 5.25H12.125C12.6773 5.25 13.125 4.80228 13.125 4.25V1ZM21 1C21 0.447715 20.5523 0 20 0H16.75C16.1977 0 15.75 0.447715 15.75 1V4.25C15.75 4.80228 16.1977 5.25 16.75 5.25H20C20.5523 5.25 21 4.80228 21 4.25V1ZM5.25 8.875C5.25 8.32272 4.80228 7.875 4.25 7.875H1C0.447715 7.875 0 8.32272 0 8.875V12.125C0 12.6773 0.447715 13.125 1 13.125H4.25C4.80228 13.125 5.25 12.6773 5.25 12.125V8.875ZM13.125 8.875C13.125 8.32272 12.6773 7.875 12.125 7.875H8.875C8.32272 7.875 7.875 8.32272 7.875 8.875V12.125C7.875 12.6773 8.32272 13.125 8.875 13.125H12.125C12.6773 13.125 13.125 12.6773 13.125 12.125V8.875ZM21 8.875C21 8.32272 20.5523 7.875 20 7.875H16.75C16.1977 7.875 15.75 8.32272 15.75 8.875V12.125C15.75 12.6773 16.1977 13.125 16.75 13.125H20C20.5523 13.125 21 12.6773 21 12.125V8.875ZM5.25 16.75C5.25 16.1977 4.80228 15.75 4.25 15.75H1C0.447715 15.75 0 16.1977 0 16.75V20C0 20.5523 0.447715 21 1 21H4.25C4.80228 21 5.25 20.5523 5.25 20V16.75ZM13.125 16.75C13.125 16.1977 12.6773 15.75 12.125 15.75H8.875C8.32272 15.75 7.875 16.1977 7.875 16.75V20C7.875 20.5523 8.32272 21 8.875 21H12.125C12.6773 21 13.125 20.5523 13.125 20V16.75ZM21 16.75C21 16.1977 20.5523 15.75 20 15.75H16.75C16.1977 15.75 15.75 16.1977 15.75 16.75V20C15.75 20.5523 16.1977 21 16.75 21H20C20.5523 21 21 20.5523 21 20V16.75Z"/>
          </svg>
        </button>
      </div>
    </form>

    <div class="col-12 catalog-apis-container">
      <div class="row">
      {{/* GetProducts aggregates across every visible catalogue, so each
           language's products are distinguished by a path prefix (set when
           each language's catalogue product is created -- see
           themes/create_dummy_product.sql / catalogue seeding) and filtered
           to match the active language here. This keeps each language's
           catalogue showing only its own products, including on a direct
           link that doesn't go through the nav's ?catalogue= selector.
           Add a `hasPrefix` line here for each additional language. */}}
      {{ $shown := 0 }}
      {{ range GetProducts req }}
        {{ $productLang := "en" }}
        {{ if hasPrefix "ar-" .Path }}{{ $productLang = "ar" }}{{ end }}
        {{ if hasPrefix "fr-" .Path }}{{ $productLang = "fr" }}{{ end }}
        {{ if hasPrefix "es-" .Path }}{{ $productLang = "es" }}{{ end }}
        {{ if eq $productLang $lang }}
          {{ $shown = add $shown 1 }}
          {{ render "catalogue_card" . }}
        {{ end }}
      {{ end }}
      {{ if eq $shown 0 }}
        <div class="col-lg-12">
          <div class="alert alert-info" role="alert">
            <i class="tyk-icon tykon tykon-warning "></i>
            <div class="alert__content">{{ index (index $t "no_apis") $lang }}</div>
          </div>
        </div>
      {{ end }}
      </div>
    </div>
  </div>
</div>
{{ end }}
