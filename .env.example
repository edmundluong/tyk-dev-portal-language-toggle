DASH_LICENSE=add_your_dashboard_licence_here
GATEWAY_VERSION="v5.13.0"
DASHBOARD_VERSION="v5.13.0"
PORTAL_VERSION="v1.18.0"
PUMP_VERSION="v1.16.0"

# --- Optional: sync env-configs/<env>/ to one or more Tyk Cloud
# environments instead of/as well as this local stack (`make render` /
# `dump-cloud` / `inspect-cloud` / `sync-cloud`, all take ENV=<name>).
# Typical use: a customer's Hybrid Gateway dev/preprod/prod environments.
#
# One CLOUD_DASHBOARD_URL_<ENV>/CLOUD_API_KEY_<ENV> pair per environment,
# <ENV> being the uppercased name you'll pass as ENV=<name>. Get both from
# that environment's own Dashboard: your profile > API Access Credentials —
# and confirm it's a Dashboard API Access Credential, not an MDCB
# registration secret (see scripts/check_cloud_permissions.py). Add as many
# environments as you need; leave all of them blank if you're only using the
# local stack.
CLOUD_DASHBOARD_URL_DEV=
CLOUD_API_KEY_DEV=
# CLOUD_DASHBOARD_URL_PREPROD=
# CLOUD_API_KEY_PREPROD=
# CLOUD_DASHBOARD_URL_PROD=
# CLOUD_API_KEY_PROD=
